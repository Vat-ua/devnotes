{
  "name": "devnotes",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "pnpm generate:social && react-router dev",
    "build": "pnpm validate:content && pnpm generate:social && react-router build",
    "generate:social": "node scripts/generate-social-cards.mjs",
    "validate:content": "node scripts/validate-content.mjs",
    "test": "node scripts/test-content-metadata.mjs && node scripts/test-brasil-em-numeros.mjs",
    "lint": "oxlint",
    "preview": "node scripts/serve-pages.mjs",
    "format": "prettier --write \"app/**/*.{js,jsx}\" \"src/**/*.{js,jsx}\" \"content/**/*.{js,jsx,mdx}\" \"scripts/**/*.{js,mjs}\" \"*.{js,json}\" \".github/**/*.{yml,yaml}\"",
    "format:check": "prettier --check \"app/**/*.{js,jsx}\" \"src/**/*.{js,jsx}\" \"content/**/*.{js,jsx,mdx}\" \"scripts/**/*.{js,mjs}\" \"*.{js,json}\" \".github/**/*.{yml,yaml}\""
  },
  "dependencies": {
    "@react-router/node": "8.3.1",
    "@shikijs/langs": "^4.4.3",
    "@shikijs/themes": "^4.4.3",
    "isbot": "^5",
    "lucide-react": "^1.38.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.1",
    "shiki": "^4.4.3"
  },
  "devDependencies": {
    "@mdx-js/rollup": "^3.1.1",
    "@react-router/dev": "8.3.1",
    "@resvg/resvg-js": "^2.6.2",
    "@shikijs/rehype": "^4.4.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "oxlint": "^1.79.0",
    "prettier": "^3.9.6",
    "vite": "^8.2.2"
  }
}
